# Key Design Studio - Apache (Timeweb / Beget / shared hosting)

Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # apex -> www
  RewriteCond %{HTTP_HOST} ^keydesign\.studio$ [NC]
  RewriteRule ^ https://www.keydesign.studio%{REQUEST_URI} [L,R=301]

  # Legacy and hidden pages
  RewriteRule ^key-design-studio\.html$ / [L,R=301]
  RewriteRule ^key-design-studio/?$ / [L,R=301]
  RewriteRule ^approach\.html$ / [L,R=302]
  RewriteRule ^partners\.html$ / [L,R=302]

  RewriteRule ^favicon\.ico$ /assets/favicon-32.png [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>
