{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "api/**",
      "admin/**",
      "oauth/**"
    ],
    "redirects": [
      {
        "source": "/index",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/little-classic.html",
        "destination": "https://www.keydesign.studio/little-classic",
        "type": 301
      },
      {
        "source": "/salok-krasoty-tati",
        "destination": "https://www.keydesign.studio/salon-krasoty-tati",
        "type": 301
      },
      {
        "source": "/salok-krasoty-tati.html",
        "destination": "https://www.keydesign.studio/salon-krasoty-tati",
        "type": 301
      },
      {
        "source": "/key-design-studio",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/key-design-studio.html",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/approach",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/approach.html",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/partners",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      },
      {
        "source": "/partners.html",
        "destination": "https://www.keydesign.studio/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/brief.php",
        "function": {
          "functionId": "brief",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ],
    "headers": [
      {
        "source": "/assets/hero/opening-curtains-v1.jpg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/assets/hero/opening-curtains-mobile-v1.webp",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/assets/hero/opening-curtains-v1.webp",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/assets/logo-v1.webp",
        "headers": [
